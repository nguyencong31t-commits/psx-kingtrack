# Điền Token nhận được từ @BotFather vào đây (Ví dụ: 7123456789:AAFlmX_vQ91k0z8XABCxyz1234567890)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Chu kỳ tự động kiểm tra hành trình đơn hàng (phút)
POLL_INTERVAL_MINUTES=20

# CSDL cục bộ mặc định (sẽ dùng nếu không cấu hình Turso)
DATABASE_PATH=trackings.db

# [Khuyên dùng cho Render] CSDL Đám mây Turso (libSQL) miễn phí vĩnh viễn (5GB - 9GB)
# Giúp dữ liệu không bao giờ bị xóa mất khi Render restart hay redeploy
# Đăng ký 1-click tại https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# [Tùy chọn] Token đối tác ViettelPost & GHTK (nếu có tài khoản đối tác thì bỏ qua giải captcha)
# VTP_TOKEN=
# GHTK_TOKEN=
